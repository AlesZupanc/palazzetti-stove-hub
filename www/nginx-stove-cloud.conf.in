# Stove website - generated by deploy.sh (last run for @DOMAIN@). Edit the
# template www/nginx-stove-cloud.conf.in and re-run deploy.sh instead of
# changing this file. Pulled into your HTTPS server block by:  include @SNIPPET@;

location = @PREFIX@ {
    return 301 @PREFIX@/$is_args$args;
}

# ^~ keeps regex locations of the site (e.g. caching rules for *.js/*.css)
# from catching the stove app's files.
location ^~ @PREFIX@/ {
    proxy_pass http://127.0.0.1:@PORT@;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    # The app only sends small JSON (accounts, the encrypted list of stoves).
    client_max_body_size 128k;
    # Service not running -> a short message instead of a bare 502.
    error_page 502 504 =503 @stove_cloud_down;

    # WebSockets: the Raspberry Pis' always-on connections and the browsers'
    # end-to-end encrypted sessions. Both sides ping every 25 s.
    location ^~ @PREFIX@/ws/ {
        proxy_pass http://127.0.0.1:@PORT@;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }
}

location @stove_cloud_down {
    default_type text/plain;
    return 503 "The stove website is restarting. Try again in a minute.\n";
}
