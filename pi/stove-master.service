[Unit]
Description=Palazzetti stove master (local dashboard, weekly scheduler, stove.local, link to the website)
Documentation=https://github.com/AlesZupanc/palazzetti-stove-hub
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=stove
Group=stove
ExecStart=/usr/bin/python3 /opt/stove-master/stove_master.py --config /etc/stove-master/stove.ini serve
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening: everything is read-only except the database folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/stove-master
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true

[Install]
WantedBy=multi-user.target
